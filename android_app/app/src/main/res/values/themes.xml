<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EKOSAntivirus" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/bg_main</item>
        <item name="colorPrimaryContainer">@color/bg_card_elevated</item>
        <item name="colorOnPrimaryContainer">@color/accent_cyan</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/status_green</item>
        <item name="colorOnSecondary">@color/bg_main</item>

        <!-- Status bar and Navigation bar color. -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>

        <!-- Material Card Styling -->
        <item name="materialCardViewStyle">@style/Widget.EKOS.CardView</item>
    </style>

    <style name="Widget.EKOS.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/bg_card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>
