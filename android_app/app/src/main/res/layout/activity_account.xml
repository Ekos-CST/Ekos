<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAccountLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:background="@color/bg_sidebar">

        <ImageButton
            android:id="@+id/btnBackFromAccount"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_main"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Hesap ve Lisans Yönetimi"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. ACTIVE PREMIUM BADGE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivePremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:strokeColor="@color/accent_amber_light"
                app:strokeWidth="1.5dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AKTİF PREMİUM ÜYELİK"
                            android:textColor="@color/accent_amber_light"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LİSANSLI"
                            android:textColor="@color/accent_emerald_light"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_card_glass"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActivePremiumCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Lisans Kodu: EKOS-PREM-XXXX-XXXX"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="monospace"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tüm derin bulut taraması, web kalkanı ve öncelikli tehdit motoru sınırsız olarak etkindir."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. LOGGED IN USER PROFILE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutProfileView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:strokeColor="@color/border_hover"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HESAP BİLGİLERİ"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Kullanıcı Adı"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kullanici@ekoscst.com"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvProfileTierBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="EKOS KURUMSAL PREMİUM"
                        android:textColor="@color/accent_purple_light"
                        android:background="@drawable/bg_card_glass"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:text="OTURUMU KAPAT"
                        android:textColor="@color/accent_crimson_light"
                        android:background="@drawable/bg_card_glass"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. PREMIUM ACTIVATION SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LİSANS AKTİVASYONU"
                android:textColor="@color/text_subtle"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:strokeColor="@color/bg_card_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LİSANS KODUNUZU GİRİNİZ:"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etProfileLicenseCode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="EKOS-PREM-XXXX-XXXX"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnApplyProfileLicense"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="LİSANS KODUNU ETKİNLEŞTİR"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:background="@drawable/bg_button_emerald" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium Feature Highlights -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/bg_card"
                app:strokeColor="@color/bg_card_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PREMIUM ÖZELLİKLERİ"
                        android:textColor="@color/accent_purple_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• 1.4M+ Küresel Bulut Tehdit Veritabanı ile Anlık Eşleme\n• Canlı Web ve Sahte Bankacılık Oltalama Kalkanı\n• Derin Depolama ve APK Analizi\n• Masaüstü ve Web Hesabı ile Çoklu Cihaz Senkronizasyonu"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. AUTH FORM VIEW -->
            <LinearLayout
                android:id="@+id/layoutAuthForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HESAP GİRİŞİ VEYA KAYIT"
                    android:textColor="@color/text_subtle"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <!-- Tab Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_glass"
                    android:padding="3dp"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/tabBtnLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="GİRİŞ YAP"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:background="@drawable/bg_button_primary" />

                    <Button
                        android:id="@+id/tabBtnRegister"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="KAYIT OL"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Login Form -->
                <LinearLayout
                    android:id="@+id/formLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-POSTA ADRESİ"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etLoginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="ornek@ekoscst.com"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_main"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ŞİFRE"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etLoginPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="••••••••"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_main"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="18dp" />

                    <Button
                        android:id="@+id/btnSubmitLogin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="GİRİŞ YAP"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:background="@drawable/bg_button_primary" />
                </LinearLayout>

                <!-- Register Form -->
                <LinearLayout
                    android:id="@+id/formRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AD SOYAD"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etRegisterName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="Adınız ve Soyadınız"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_main"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-POSTA"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etRegisterEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="ornek@ekoscst.com"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_main"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ŞİFRE"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etRegisterPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="En az 6 karakter"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_main"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GÜVENLİK SORUSU CEVABI"
                        android:textColor="@color/text_subtle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etRegisterSecAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_glass"
                        android:hint="Güvenlik cevabınız"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_main"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnSubmitRegister"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="HESAP OLUŞTUR"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:background="@drawable/bg_button_emerald" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
