<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWebShieldLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/btnBackFromWeb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_main"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Canlı Web &amp; Oltalama Kalkanı"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Şüpheli gördüğünüz web sitelerini ve linkleri EKOS Derin Sinirsel Analiz Motoru ile anında tarayın."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Input Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/bg_card_border"
        app:strokeWidth="1dp"
        app:cardCornerRadius="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etTargetUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_card_glass"
                android:hint="https://ornek-supheli-site.com"
                android:textColorHint="@color/text_subtle"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:inputType="textUri"
                android:paddingHorizontal="14dp" />

            <Button
                android:id="@+id/btnScanUrlSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="URL ANALİZİ BAŞLAT"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scan Result Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUrlResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/accent_emerald"
        app:strokeWidth="1dp"
        app:cardCornerRadius="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvUrlResultVerdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAĞLANTI GÜVENLİ"
                android:textColor="@color/accent_emerald_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUrlResultEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Motor: EKOS Bulut Tehdit Kalkanı"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvUrlResultMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Web sitesi zararsızdır."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
