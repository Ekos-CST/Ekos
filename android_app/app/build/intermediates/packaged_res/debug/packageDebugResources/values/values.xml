    <string name="app_name">Ekos CST</string>
    <string name="btn_quick_scan">HIZLI SİSTEM TARAMASI BAŞLAT</string>
    <string name="btn_web_shield">Canlı Web ve Oltalama Kalkanı</string>
    <string name="shield_protected_sub">Gerçek zamanlı tarama motoru ve bulut tehdit kalkanı aktif.</string>
    <string name="shield_protected_title">CİHAZINIZ KORUMA ALTINDA</string>
    <style name="Theme.EKOSAntivirus" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bg_card_elevated</item>
        <item name="colorOnPrimaryContainer">@color/accent_purple_light</item>

        
        <item name="colorSecondary">@color/accent_emerald</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>

        
        <item name="android:windowLayoutInDisplayCutoutMode" ns1:targetApi="p">shortEdges</item>

        
        <item name="materialCardViewStyle">@style/Widget.EKOS.CardView</item>
    </style>
    <style name="Widget.EKOS.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/bg_card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
    </style>
