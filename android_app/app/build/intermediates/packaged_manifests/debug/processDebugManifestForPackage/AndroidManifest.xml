<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ekos.antivirus"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Permissions for Real-Time Threat Analysis & Cloud Engine -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <permission
        android:name="com.ekos.antivirus.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.ekos.antivirus.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EKOSAntivirus"
        android:usesCleartextTraffic="true" >

        <!-- FileProvider for In-App Updates & APK Installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ekos.antivirus.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Main Dashboard Activity -->
        <activity
            android:name="com.ekos.antivirus.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Threat Scanner Activity -->
        <activity
            android:name="com.ekos.antivirus.ScanActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Web & Phishing Shield Activity -->
        <activity
            android:name="com.ekos.antivirus.WebShieldActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Deep Storage & App Scanner Activity -->
        <activity
            android:name="com.ekos.antivirus.DeepScanActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Account Login & Management Activity -->
        <activity
            android:name="com.ekos.antivirus.AccountActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- System Optimization Hub Activity -->
        <activity
            android:name="com.ekos.antivirus.SystemOptimizationActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Junk & Cache Cleaner Activity -->
        <activity
            android:name="com.ekos.antivirus.CleanerActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Privacy & Permissions Guard Activity -->
        <activity
            android:name="com.ekos.antivirus.PrivacyGuardActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Network & Wi-Fi Shield Activity -->
        <activity
            android:name="com.ekos.antivirus.NetworkShieldActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- RAM & Performance Booster Activity -->
        <activity
            android:name="com.ekos.antivirus.RamBoosterActivity"
            android:exported="false"
            android:parentActivityName="com.ekos.antivirus.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Background Security Service -->
        <service
            android:name="com.ekos.antivirus.service.BackgroundShieldService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Real-Time Package Install & Update Receiver -->
        <receiver
            android:name="com.ekos.antivirus.receiver.PackageInstallReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.ekos.antivirus.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>