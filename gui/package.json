{
  "name": "ekos-antivirus",
  "productName": "EKOS Antivirüs",
  "version": "2.4.0",
  "description": "EKOS Antivirüs Güvenlik Motoru ve Gösterge Paneli",
  "author": "Eren Can Uçar",
  "copyright": "Copyright © 2026 Eren Can Uçar. Tüm Hakları Saklıdır.",
  "license": "Proprietary",
  "main": "main_electron.js",
  "scripts": {
    "start": "electron main_electron.js",
    "server": "node server.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ekos.antivirus",
    "productName": "EKOS Antivirüs",
    "copyright": "Copyright © 2026 Eren Can Uçar. Tüm Hakları Saklıdır.",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "EkosAntivirus.exe",
        "to": "EkosAntivirus.exe"
      }
    ],
    "files": [
      "**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://releases.ekos-antivirus.com/update/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EKOS Antivirüs",
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico",
      "installerHeaderIcon": "public/assets/icon.ico",
      "license": "LICENSE.txt",
      "artifactName": "EKOS Antivirüs Setup ${version}.${ext}",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^43.2.0"
  }
}
